# ============================================================================
# FoodBridge Production Environment Configuration Template
# Target: Production Server / Spring Boot / React Application
# ============================================================================

# Server Configuration
PORT=8080
VITE_API_BASE_URL=http://localhost:8080/api/v1

# Database Configuration (MySQL 8.0 / PostgreSQL)
DATABASE_URL=jdbc:mysql://localhost:3306/foodbridge_db?useSSL=false&serverTimezone=UTC
DATABASE_USERNAME=
DATABASE_PASSWORD=

# JWT Authentication Configuration
JWT_SECRET=
JWT_EXPIRATION_MS=86400000

# Google OAuth2 Authentication Credentials
VITE_GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=

# Real SMS OTP Authentication Credentials (Twilio / SMS Gateway)
SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
TWILIO_SENDER_PHONE_NUMBER=

# Section 80G Tax Receipt Signature Keys
TAX_80G_REGISTRATION_NUMBER=AAATF1234F20261
TAX_80G_SIGNING_KEY=
